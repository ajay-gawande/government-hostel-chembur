<% layout("/layout/boilerplate.ejs") %>

<!-- admission section  -->

<section class="admission-section">
    <div class="container eligible-criteria">

        <div class="eligible-heading">
            <h2 class="main-heading">प्रवेशासाठी पात्रता</h2>
            <p class="sub-heading">
               डॉ. बाबासाहेब आंबेडकर शासकीय मुलांचे वसतिगृह (युनिट १, २, ३) तसेच संत एकनाथ मागासवर्गीय मुलांचे वसतिगृहामध्ये प्रवेश घेण्यासाठी विद्यार्थ्यांनी खालील पात्रता निकष पूर्ण करणे आवश्यक आहे. </p>
        </div> 

        <table class="eligible-criteria-table">
            <tbody>
                    <tr>
                        <td class="eligible-rule">महाराष्ट्र राज्याचा रहिवासी असणे आवश्यक.</td>
                        <td class="sub-rules">विद्यार्थी महाराष्ट्र राज्याचा कायमस्वरूपी रहिवासी असावा. महाराष्ट्र राज्याबाहेरील विद्यार्थ्यांना वसतिगृह प्रवेशासाठी पात्रता राहणार नाही.</td>
                    </tr>
                    <tr>
                        <td class="eligible-rule">मुंबईतील स्थानिक रहिवासी नसावा.</td>
                        <td class="sub-rules">विद्यार्थी बृहन्मुंबई महानगरपालिका क्षेत्रातील (मुंबई शहर / मुंबई उपनगर) स्थानिक रहिवासी नसावा. विद्यार्थ्याच्या डोमिसाईल प्रमाणपत्रावर किंवा आधार कार्डावर मुंबई शहर अथवा मुंबई उपनगरचा पत्ता नसावा (मांग मेहतर सोडून).</td>
                    </tr>
                    <tr>
                        <td class="eligible-rule">आरक्षित प्रवर्गातील विद्यार्थी</td>
                        <td class="sub-rules">विद्यार्थ्याकडे अनुसूचित जाती (SC), अनुसूचित जमाती (ST), विमुक्त जाती व भटक्या जमाती (VJNT), इतर मागासवर्गीय (OBC), विशेष मागास प्रवर्ग (SBC) किंवा आर्थिकदृष्ट्या दुर्बल घटक (EWS) यांपैकी संबंधित प्रवर्गाचा वैध दाखला असणे आवश्यक आहे.</td>
                    </tr>
                    <tr>
                        <td class="eligible-rule">उत्पन्न मर्यादा.</td>
                        <td class="sub-rules">विद्यार्थ्याच्या कुटुंबाचे वार्षिक उत्पन्न ₹2,50,000 पेक्षा कमी असणे आवश्यक आहे.</td>
                    </tr>
                    <tr>
                        <td class="eligible-rule">गुणवत्ता व आरक्षणानुसार प्रवेश</td>
                        <td class="sub-rules">तसेच इतर अटीची पुर्तता करणाऱ्या विद्यार्थ्यांना गुणवत्ता यादीच्या अनुषंगाने तसेच प्रवर्गनिहाय आरक्षण व रिक्त जागांच्या उपलब्धतेनुसार प्रवेश देण्यात येईल.</td>
                    </tr>
            </tbody>
        </table>
    </div>


</section>



<section class="document-section">
    <div class="container">

        <div class="document-heading">
            <h2>आवश्यक कागदपत्रे</h2>
            <p>प्रवेश अर्जासोबत खालील कागदपत्रे सादर करणे आवश्यक आहे:</p>
        </div>

        <div class="documnet-list">
        <ol>
            <li>जात प्रमाणपत्र (Caste Certificate)</li>
            <li>रहिवासी प्रमाणपत्र (Domicile Certificate)</li>
            <li>मागील वर्षाचे गुणपत्रक (Marksheet)</li>
            <li>शाळा सोडल्याचा दाखला (Leaving / Transfer Certificate)</li>
            <li>उत्पन्न प्रमाणपत्र (Income Certificate)</li>
            <li>चालू शैक्षणिक वर्षाचे बोनाफाईड प्रमाणपत्र</li>
            <li>विद्यार्थी व पालक घोषणा पत्र (Declaration Form)</li>
            <li>वैद्यकीय / शारीरिक तंदुरुस्ती प्रमाणपत्र (medical fitness certificate MBBS)</li>
            <li>SBI किंवा इतर राष्ट्रीयीकृत बँकेचे खाते तपशील</li>
        </ol>
    </div>

    </div>

    

</section >
   
<section class="application-form-section">
     <div class="container">
        <div class="highlight ">
            <h5><b>प्रवेश अर्ज भरा</b></h5>
          <ul>
            <li> वरील सर्व पात्रता निकष, अटी व शर्ती तसेच आवश्यक कागदपत्रे काळजीपूर्वक वाचून, आपण प्रवेशासाठी पात्र असल्याची खात्री झाल्यानंतरच प्रवेश अर्ज भरावा.</li>
            <li>अर्ज भरताना सर्व माहिती अचूक व संपूर्ण स्वरूपात नमूद करावी. चुकीची, अपूर्ण किंवा खोटी माहिती आढळल्यास अर्ज रद्द करण्यात येऊ शकतो.</li>
            <li>प्रवेश प्रक्रियेसंबंधी सर्व नियम व अटींचे पालन करणे अर्जदारासाठी बंधनकारक आहे.</li>
          </ul>
          <p><b>खालील बटणावर क्लिक करून ऑनलाइन प्रवेश अर्ज भरा.</b></p>
          <a class=" form-fill-btn" href="https://hmasnew.mahait.org/" target="_blank">प्रवेश अर्ज भरा</a>
        </div>
    </div>
</section>