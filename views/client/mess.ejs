<!--  TIMINGS -->
<section class="timings section">
  <div class="container">

    <div class="timings-header">
      <h2>मेस वेळापत्रक</h2>
      <p>विद्यार्थ्यांसाठी दररोजचा जेवणाचा वेळ</p>
    </div>

    <div class="timings-grid">

      <div class="timing-card">
        <div class="icon"><i class="fa-solid fa-mug-hot"></i></div>
        <h3>नाश्ता</h3>
        <p class="time">सकाळी 6:30 ते 9:00</p>
      </div>

      <div class="timing-card">
        <div class="icon"><i class="fa-solid fa-utensils"></i></div>
        <h3>दुपारचे जेवण</h3>
        <p class="time">दुपारी 12:00 ते 3:00</p>
      </div>

      <div class="timing-card">
        <div class="icon"><i class="fa-solid fa-moon"></i></div>
        <h3>रात्रीचे जेवण</h3>
        <p class="time">सायंकाळी 7:00 ते 9:30</p>
      </div>

    </div>

  </div>
</section>

<!--  RULES -->
<section class="rules section light">
  <div class="container">

    <div class="rules-header">
      <h2>नियम</h2>
      <p>शिस्तबद्ध आणि चांगले वातावरण राखण्यासाठी मार्गदर्शक सूचना</p>
    </div>

    <div class="rules-grid">

      <div class="rule-card">
        <div class="rule-icon"><i class="fa-solid fa-user-shield"></i></div>
        <h3>शिस्त राखा</h3>
        <p>सर्व विद्यार्थ्यांनी वसतिगृहाची शिस्त नेहमी पाळावी.</p>
      </div>

      <div class="rule-card">
        <div class="rule-icon"><i class="fa-solid fa-utensils"></i></div>
        <h3>अन्न वाया घालवू नका</h3>
        <p>फक्त आवश्यक तेवढेच अन्न घ्या आणि अन्न वाया घालवणे टाळा.</p>
      </div>

      <div class="rule-card">
        <div class="rule-icon"><i class="fa-solid fa-clock"></i></div>
        <h3>वेळेचे पालन करा</h3>
        <p>नाश्ता, दुपारचे जेवण आणि रात्रीचे जेवण यांच्या वेळांचे काटेकोर पालन करा.</p>
      </div>

      <div class="rule-card">
        <div class="rule-icon"><i class="fa-solid fa-broom"></i></div>
        <h3>स्वच्छता राखा</h3>
        <p>जेवणाची जागा आणि परिसर वापरल्यानंतर स्वच्छ ठेवा.</p>
      </div>

    </div>

  </div>
</section>

<!--  FEEDBACK -->
<section class="feedback section">
  <div class="container">

