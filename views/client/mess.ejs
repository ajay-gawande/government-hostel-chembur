        <!-- CARD -->
        <!-- सोमवार -->
        <div class="day-card">
          <h3>सोमवार</h3>
          <p><span>नाश्ता:</span> केळी, २५० मि.ली. दूध, २ अंडी, बिस्कीट, सफरचंद, पोहे</p>
          <p><span>टिफिन:</span> चपाती, पिवळी बटाटा भाजी</p>
          <p><span>दुपारचे जेवण:</span> सलाड, तूप, लोणचे, चपाती, भात, डाळ, मटकी रस्सा भाजी</p>
          <p><span>रात्रीचे जेवण:</span> सलाड, तूप, लोणचे, पापड, चपाती, भात, डाळ, राजमा रस्सा भाजी, टोमॅटो चटणी</p>
        </div>

        <!-- मंगळवार -->
        <div class="day-card">
          <h3>मंगळवार</h3>
          <p><span>नाश्ता:</span> केळी, २५० मि.ली. दूध, २ अंडी, बिस्कीट, आंबा, साबुदाणा खिचडी</p>
