<% layout("/layout/boilerplate.ejs") %>

<!-- facility-section cards -->
<section class="facility-section container " >
  <div class="container">

    <div class="facility-heading ">
       <h2 class="main-heading">आमच्या सुविधा</h2>
       <p class="sub-heading">विद्यार्थ्यांच्या शैक्षणिक, शारीरिक आणि सर्वांगीण विकासासाठी वसतिगृहात विविध आधुनिक सुविधा उपलब्ध करून देण्यात आल्या आहेत. सुरक्षित, स्वच्छ आणि अभ्यासासाठी पोषक वातावरण निर्माण करण्यासाठी आवश्यक सर्व सुविधा येथे उपलब्ध आहेत.</p>
    </div>


    <div class="swiper facilitySwiper">

      <div class="swiper-wrapper">

        <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444220/reading_room_jl9anz.png " alt="Government Hostel Chembur library-books" loading="lazy">
            <div class="card-content">
              <h3>ग्रंथालय</h3>
              <h4>ज्ञानाचा समृद्ध खजिना</h4>
              <p>हजारो शैक्षणिक, स्पर्धा परीक्षा, संदर्भ व साहित्यिक पुस्तकांचा संग्रह विद्यार्थ्यांसाठी उपलब्ध आहे.</p>
            </div>
          </div>
        </div>
          
        <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1774861362/hostel/orjzcd77wwab9x4kvfog.png" alt="Government Hostel Chembur computer-room" loading="lazy">
            <div class="card-content">
              <h3>संगणक कक्ष</h3>
              <h4>डिजिटल शिक्षणासाठी सुविधा</h4>
              <p>वातानुकूलित संगणक कक्षामध्ये ऑनलाईन अभ्यास, प्रकल्प आणि संशोधनासाठी सुविधा उपलब्ध आहेत.</p>
            </div>
          </div>
        </div>

        <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444832/carom_nmkdb6.png" alt="Government Hostel Chembur indoor game">
            <div class="card-content" loading="lazy">
              <h3>अंतर्गत खेळ</h3>
              <h4>मनोरंजनासह बौद्धिक विकास</h4>
              <p>कॅरम, टेबल टेनिस आणि बुद्धिबळ यांसारख्या खेळांद्वारे विद्यार्थ्यांच्या कौशल्यांना चालना मिळते.</p>
            </div>
          </div>
        </div>

        <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444286/criket_pmkitu.jpg" alt="Government Hostel Chembur outdoor game">
            <div class="card-content" loading="lazy">
              <h3>मैदानी खेळ</h3>
              <h4>क्रीडेला प्रोत्साहन देणारे वातावरण</h4>
              <p>क्रिकेट, बॅडमिंटन, टेनिस आणि व्हॉलीबॉलसाठी प्रशस्त क्रीडांगण उपलब्ध आहे.</p>
            </div>
          </div>
        </div>

          <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444219/GYM_xpy8ec.png" alt="Government Hostel Chembur gym">
            <div class="card-content" loading="lazy">
              <h3>व्यायामशाळा</h3>
              <h4>निरोगी शरीर, सशक्त मन</h4>
              <p>विद्यार्थ्यांच्या शारीरिक तंदुरुस्तीसाठी आधुनिक जिम आणि ओपन जिमची सुविधा उपलब्ध आहे.</p>
            </div>
          </div>
        </div>

          <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444219/room_cacyiu.png" alt="Government Hostel Chembur room">
            <div class="card-content" loading="lazy">
              <h3>निवासी व्यवस्था</h3>
              <h4>आरामदायी आणि सुरक्षित निवास</h4>
              <p>प्रशस्त खोल्या, बेड आणि कपाटांसह विद्यार्थ्यांच्या राहण्याची उत्तम व्यवस्था करण्यात आली आहे.</p>
            </div>
          </div>
        </div>


          <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444923/mess_vgvjar.png" alt="Government Hostel Chembur canteen">
            <div class="card-content" loading="lazy">
              <h3>भोजन व्यवस्था</h3>
              <h4>पौष्टिक आणि संतुलित आहार</h4>
              <p>नाश्ता, दुपारचे जेवण आणि रात्रीचे जेवण स्वच्छ व पौष्टिक पद्धतीने उपलब्ध करून दिले जाते.</p>
            </div>
          </div>
        </div>

          <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444220/water-cooler_pmblvs.png" alt="Government Hostel Chembur water cooler" loading="lazy">
            <div class="card-content">
              <h3>शुद्ध पिण्याचे पाणी</h3>
              <h4>प्रत्येक मजल्यावर सुविधा</h4>
              <p>शुद्ध, थंड आणि सुरक्षित पिण्याच्या पाण्यासाठी वॉटर कूलरची व्यवस्था करण्यात आली आहे.</p>
            </div>
          </div>
        </div>

          <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444219/Wash-machin_mdsari.png" alt="Government Hostel Chembur washing machine" loading="lazy">
            <div class="card-content">
              <h3>धुलाई सुविधा</h3>
              <h4>दैनंदिन गरजांसाठी सोय</h4>
              <p>विद्यार्थ्यांच्या सोयीसाठी वॉशिंग मशीनची सुविधा उपलब्ध आहे.</p>
            </div>
          </div>
        </div>

          <div class="swiper-slide">
          <div class="facility-cards">
            <img  src="https://res.cloudinary.com/dmtdl93vz/image/upload/f_auto,q_auto,w_800/v1781444219/paring-area_j20rpp.png" alt="Government Hostel Chembur parking area" loading="lazy">
            <div class="card-content">
              <h3>वाहनतळ</h3>
              <h4>सुरक्षित पार्किंग व्यवस्था</h4>
              <p>सायकल आणि दुचाकी वाहनांसाठी स्वतंत्र व सुरक्षित पार्किंगची सुविधा उपलब्ध आहे.</p>
            </div>
          </div>
        </div>


      </div>

      <div class="swiper-pagination"></div>
    

    </div>
  </div>
    

</section>


    
<!-- Finacial-allowance-section -->

<section class="finacial-support">

  <div class="container">

    <div class="finacial-support-heading">
      <h2>विद्यार्थ्यांसाठी आर्थिक व शैक्षणिक सहाय्य</h2>
      <p>महाराष्ट्र शासनामार्फत विद्यार्थ्यांना शिक्षणासाठी आवश्यक आर्थिक व शैक्षणिक सहाय्य उपलब्ध करून दिले जाते. यामध्ये निर्वाह भत्ता, शैक्षणिक साहित्य, विविध अभ्यासक्रमांसाठी आवश्यक साधने तसेच इतर शैक्षणिक सुविधांचा समावेश आहे. खालील तक्त्यामध्ये उपलब्ध सहाय्याची माहिती दिली आहे.</p>
    </div>

    <div class="finacial-support-table">
      <table class="finacial-table">
        <thead>
          <tr>
            <th>सुविधा / सहाय्य</th>
            <th>रक्कम /दरवर्षी प्रति विद्यार्थी</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>निर्वाह भत्ता</td>
            <td>रु.१५००/- प्रति महिना</td>
          </tr>
          <tr>
            <td>शालेय गणवेश</td>
            <td>२ जोड, रु.५००/- प्रति </td>
          </tr>
          <tr>
          <tr>
            <td>महाविद्यालयीन ड्रेस कोड </td>
            <td>२ जोड, रु.१०००/- प्रति </td>
          </tr>
          <tr>
            <td>वैद्यकीय अभ्यासक्रम एप्रनसाठी</td>
            <td>रु.५००/-</td>
          </tr>
          <tr>
            <td>वैद्यकीय अभ्यासक्रम साहित्य</td>
            <td>रु.२०००/- </td>
          </tr>
          <tr>
            <td>अभियांत्रिकी विद्यार्थी ड्रॉईंग/बॉयलर सूट</td>
            <td>रु.५००/- </td>
          </tr>
          <tr>
            <td>अभियांत्रिकी विद्यार्थी ड्रॉईंग बोर्ड व साहित्य</td>
            <td>२५००/- </td>
          </tr>
          <tr>
            <td>लॅब एप्रनसाठी</td>
            <td>रु.५००/-</td>
          </tr>
            <tr>
            <td>शारीरिक शिक्षण महाविद्यालय 2 गणवेशासाठी</td>
            <td>रु.४०००/-</td>
          </tr>
          <tr>
            <td>छत्री/रेनकोट व गमबूट</td>
            <td>रु.५००/- </td>
          </tr>
          <tr>
            <td>कला, विज्ञान व वाणिज्य शाखेतील विद्यार्थ्यांना साहित्याकरिता</td>
            <td>रु.४०००/- </td>
          </tr>
          <tr>
            <td> शैक्षणिक सहलीसाठी </td>
            <td> रु.२०००/- </td>
          </tr>
          <tr>
            <td>कार्यशाळा / कौशल्य विकास</td>
            <td>रु.५००/- </td>
          </tr>
            <tr>
            <td>प्रोजेक्ट रिपोर्ट</td>
            <td>रु.१०००/-  </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="highlight">
      <h5><b>सूचना</b></h5>
      <p  class="highlight-content">वरील तक्त्यामधील रक्कम व सुविधा शासनाच्या नियमांनुसार वेळोवेळी बदलू शकतात. अद्ययावत व सविस्तर माहितीसाठी कृपया वसतिगृह कार्यालयाशी किंवा संबंधित अधीक्षक (Warden) यांच्याशी संपर्क साधावा.</p>
    </div>

  </div>

</section>

<!-- facility-section card swiping  -->
<script>
document.addEventListener("DOMContentLoaded", () => {

  new Swiper(".facilitySwiper", {
    loop: true,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },

   
    spaceBetween: 30,
    breakpoints: {
      0: { slidesPerView: 1 },
      480:{slidesPerView:2},
      768: { slidesPerView: 3 }
    }
  });

});
</script>

