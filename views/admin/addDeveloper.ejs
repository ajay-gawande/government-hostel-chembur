<% layout('layout/admin') %>
<h2>Add Developer</h2>

<form action="/admin/developer" method="POST" enctype="multipart/form-data">
  <input type="text" name="own" value="developer">
  <input type="text" name="name" placeholder="Name" required>
  <input type="email" name="email" placeholder="Email">

  <input type="text" name="whatsapp" placeholder="WhatsApp Link">
  <input type="text" name="instagram" placeholder="Instagram Link">
  <input type="text" name="telegram" placeholder="Telegram Link">
  <input type="text" name="linkedin" placeholder="LinkedIn Link">

  <!-- IMAGE -->
  <input type="file" name="image" accept="image/*">

  <button type="submit">Add Developer</button>
</form>