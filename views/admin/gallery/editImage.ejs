<% layout('layout/admin') %>

<h2>Edit Gallery</h2><br>

<form action="/admin/gallery/edit/<%= gallery._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
<p><b>category: </b><%= gallery.category %></p><br>
<span>add image releted to Hostel Building, Rooms, Entrance, Hostel Office, Corridors, Water Cooler, Reading Hall</span><br><br>    
  <input type="text" name="title" value="<%= gallery.title %>" placeholder="Title"><br>
  <textarea name="discription"><%= gallery.discription %></textarea><br>

  <input type="file" name="image" multiple><br><br>

 

  <button type="submit">Update</button>

</form>

 <hr>
  
