<% layout('layout/admin') %>
<div class="admin-container">

  <h2>Edit Developer</h2>

  <form action="/admin/developer/edit/<%= dev._id %>?_method=PUT" method="POST" enctype="multipart/form-data">

    <input type="text" name="name" value="<%= dev.name %>" placeholder="Name" required>

    <input type="email" name="email" value="<%= dev.email %>" placeholder="Email">

    <input type="text" name="whatsapp" value="<%= dev.whatsapp %>" placeholder="WhatsApp">

    <input type="text" name="instagram" value="<%= dev.instagram %>" placeholder="Instagram">

    <input type="text" name="telegram" value="<%= dev.telegram %>" placeholder="Telegram">

    <input type="text" name="linkedin" value="<%= dev.linkedin %>" placeholder="LinkedIn">

    <input type="file" name="image">

    <button type="submit">Update</button>

  </form>

</div>