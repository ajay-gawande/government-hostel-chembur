<% layout('layout/admin') %>

<h2>Sections for this page</h2>

<!-- add section form -->
<a href="/admin/add-section/<%=page %>">
  <button>Add Section</button>
</a>

<hr>

<% if(sections.length === 0){ %>
  <p>No sections found</p>
<% } %>

<% sections.forEach(sec => { %>

  <div style="border:1px solid #ccc; padding:15px; margin:10px 0;">

    <h3>Section: <%= sec.section %></h3>

    <p><strong>Title:</strong> <%= sec.title %></p>
    <p><strong>Subtitle:</strong> <%= sec.subtitle %></p>
    <p><strong>Discription:</strong> <%= sec.discription%></p>
    <p><strong>Para1:</strong> <%= sec.para1%></p>
    <p><strong>Para2:</strong> <%= sec.para2%></p>
    <p><strong>Para3:</strong> <%= sec.para3%></p>
    <p><strong>Para4:</strong> <%= sec.para4%></p>
    <p><strong>bold1:</strong> <%= sec.bold1%></p>
    <p><strong>bold2:</strong> <%= sec.bold2%></p>
      
    <p><strong>Flag:</strong> <%= sec.flag %></p>
<% if (sec.media && sec.media.length > 0) {%>
      <% sec.media.forEach(file => { %>
        <% if(file.type=="image") { %>
            <img src="<%= file.url%>" width="200">
        <% } else { %>
              <video src="<%= file.url%>" controls width="200"></video>
          <% } %>
      <% }) %>
<% } %>

<br><br>
    <a href="/admin/edit/<%= sec._id %>">
      <button>Edit</button>
    </a>

   <form action="/admin/delete-section/<%= sec._id %>?_method=DELETE" 
      method="POST"
      onsubmit="return confirm('Are you sure you want to delete this section?')">
  
  <button style="color:red;">Delete Section</button>
</form>

  </div>

<% }) %>