<% layout('layout/admin') %>
<div class="admin-container">

  

  <div class="table-wrapper">

    <h2 class="page-title ">Contact Messages</h2>
    <table class="contact-table">

      <thead>
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Email</th>
          <th>Subject</th>
          <th>Message</th>
          <th>Date</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% if(contacts.length > 0) { %>
          <% contacts.forEach((c, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= c.name %></td>
              <td><%= c.email %></td>
              <td><%= c.subject || "-" %></td>
              <td class="msg"><%= c.message %></td>
              <td>
                <%= new Date(c.createdAt).toLocaleDateString() %>
              </td>
              <td>  <form action="/admin/contact/delete/<%= c._id %>?_method=DELETE" method="POST">
                <button type="submit" class="delete-btn">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="no-data">No messages found</td>
          </tr>
        <% } %>
      </tbody>

    </table>
  </div>

</div>