     <div class="developer-contact">
      <button id="devBtn">
          <i class="fa-solid fa-user"></i> Contact Developer
      </button>
  </div>
  </div>

  <!-- MODAL -->
  <div id="devModal" class="modal">
    <div class="modal-box">

      <span class="close" id="closeModal">&times;</span>

      <div class="dev-header">
        <img src="<%= developer?.image?.url || '/images/default-user.png' %>" />
        <h3><%= developer?.name || 'Developer' %></h3>
        <p class="dev-role">Full Stack Developer</p>
      </div>

      <div class="dev-links">

        <% if (developer?.whatsapp) { %>
        <a href="<%= developer.whatsapp %>" target="_blank">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp
        </a>
        <% } %>

        <% if (developer?.instagram) { %>
        <a href="<%= developer.instagram %>" target="_blank">
          <i class="fa-brands fa-instagram"></i> Instagram
        </a>
        <% } %>

        <% if (developer?.telegram) { %>
        <a href="<%= developer.telegram %>" target="_blank">
          <i class="fa-brands fa-telegram"></i> Telegram
        </a>
        <% } %>

        <% if (developer?.email) { %>
        <a href="mailto:<%= developer.email %>">
          <i class="fa-solid fa-envelope"></i> Email
        </a>
        <% } %>

        <% if (developer?.linkedin) { %>
        <a href="<%= developer.linkedin %>" target="_blank">
          <i class="fa-brands fa-linkedin"></i> LinkedIn
        </a>
        <% } %>

      </div>

    </div>
  </div>
</footer>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const modal = document.getElementById("devModal");
  const btn = document.getElementById("devBtn");
  const closeBtn = document.getElementById("closeModal");

  btn.addEventListener("click", function () {
    modal.classList.add("active");
  });

  closeBtn.addEventListener("click", function () {
    modal.classList.remove("active");
  });

  window.addEventListener("click", function (e) {
    if (e.target === modal) {
      modal.classList.remove("active");
    }
  });

});
</script>