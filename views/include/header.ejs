<script>
    const navItems = document.querySelectorAll(".nav-option");
    const navContainer = document.querySelector(".nav-option-container");

    function setActiveNav() {
        const currentPath = window.location.pathname;

        navItems.forEach(item => {
            item.classList.remove("active");

            const link = item.querySelector("a").getAttribute("href");

            if (link === currentPath) {
                item.classList.add("active");

                // Mobile navbar auto scroll
                setTimeout(() => {
                    item.scrollIntoView({
                        behavior: "smooth",
                        block: "nearest",
                        inline: "center"
                    });
                }, 100);
            }
        });
    }

    // Run on page load
    setActiveNav();

    // Handle browser back/forward
    window.addEventListener("popstate", setActiveNav);
</script>
